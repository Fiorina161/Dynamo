@page "/Shares/{id:long}"
@model Dynamo.Pages.Shares.BrowseModel
@using Dynamo.Modules.Shares
@{
    ViewData["Title"] = Model.Folder.Name;
    var listing = Model.Listing;

    string Link(string? path, string? sort = null, bool? desc = null, int page = 1) =>
        Url.Page("/Shares/Browse", new
        {
            id = Model.Folder.Id,
            path = string.IsNullOrEmpty(path) ? null : path,
            q = Model.Query.Length == 0 ? null : Model.Query,
            sort = (sort ?? Model.Sort) == "name" ? null : (sort ?? Model.Sort),
            dir = (desc ?? Model.Descending) ? "desc" : null,
            p = page > 1 ? page : (int?)null,
        })!;

    // A column header: sorts by it; again reverses.
    string SortLink(string key) =>
        Link(listing?.Relative, key, Model.Sort == key && !Model.Descending);
    string Arrow(string key) => Model.Sort == key ? (Model.Descending ? " ▼" : " ▲") : "";

    string HumanSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return i == 0 ? $"{bytes} B" : $"{v:0.##} {units[i]}";
    }
}

<header class="page-head">
    <div class="greeting">
        <p><a class="back" href="@Url.Page("/Shares/Index")">← Shared folders</a></p>
        <h1>@Model.Folder.Name</h1>
        <p><code>@Model.Folder.Path</code> · read as @Model.Folder.Username</p>
    </div>
</header>

@if (Model.Error is not null)
{
    <p class="error">@Model.Error</p>
    <p class="hint-text">The account and the folder are changed from the <a href="@Url.Page("/Shares/Index")">list</a> (Edit).</p>
}
else if (listing is not null)
{
    // One level up: the folder before the last one of the breadcrumb, or the top of the shared folder.
    string? parent = listing.Breadcrumb.Count == 0 ? null
        : listing.Breadcrumb.Count == 1 ? "" : listing.Breadcrumb[^2].Relative;
    @* Where you are, and the way back: the Up button, the breadcrumb (each part is a link), and the ".." row of the list. *@
    <nav class="crumbs" aria-label="Where you are">
        @if (parent is not null)
        {
            <a class="button ghost up-btn" href="@Link(parent)" title="Back to the folder above">↑ Up</a>
        }
        @if (listing.Breadcrumb.Count == 0)
        {
            <strong class="crumb-current">@Model.Folder.Name</strong>
        }
        else
        {
            <a class="crumb" href="@Link(null)">@Model.Folder.Name</a>
            @for (var i = 0; i < listing.Breadcrumb.Count; i++)
            {
                var crumb = listing.Breadcrumb[i];
                <span class="crumb-sep" aria-hidden="true">›</span>
                @if (i == listing.Breadcrumb.Count - 1)
                {
                    <strong class="crumb-current">@crumb.Name</strong>
                }
                else
                {
                    <a class="crumb" href="@Link(crumb.Relative)">@crumb.Name</a>
                }
            }
        }
    </nav>

    @if (Model.Folder.AllowUpload)
    {
        @* Upload (site.js, "Uploading files to a shared folder"): into the folder you are in. *@
        <section class="upload-box" aria-label="Upload files"
                 data-upload-url="@Url.Page("/Shares/Browse", "Upload", new { id = Model.Folder.Id, path = listing.Relative })">
            <label class="button upload-pick">Upload files…
                <input type="file" multiple hidden />
            </label>
            <span class="hint-text">or drop files anywhere on this page. They go into
                <strong>@(listing.Relative.Length == 0 ? Model.Folder.Name : listing.Relative)</strong>.</span>
            <button type="button" class="ghost small" data-upload-cancel hidden>Cancel</button>
            <ul class="upload-list" aria-live="polite"></ul>
        </section>
    }

    @* The folder's substrings: tick some and only the files whose name contains one of them are listed. *@
    <section class="name-filters" aria-label="Substrings to keep">
        <span class="name-filters-title">Substrings</span>
        @foreach (var sub in Model.Filters)
        {
            <span class="chip@(sub.Active ? " on" : "")">
                <label>
                    <input type="checkbox" name="active" value="true" checked="@sub.Active"
                           hx-post="@Url.Page("/Shares/Browse", "ToggleFilter", new { id = Model.Folder.Id, filter = sub.Id })"
                           hx-trigger="change" hx-swap="none" />
                    @sub.Text
                </label>
                <button type="button" class="chip-edit" title="Change or remove “@sub.Text”" aria-label="Change @sub.Text"
                        hx-get="@Url.Page("/Shares/Browse", "FilterForm", new { id = Model.Folder.Id, filter = sub.Id })"
                        hx-target="#dlg" hx-swap="innerHTML">✎</button>
            </span>
        }
        <button type="button" class="ghost small"
                hx-get="@Url.Page("/Shares/Browse", "FilterForm", new { id = Model.Folder.Id, filter = 0 })"
                hx-target="#dlg" hx-swap="innerHTML">+ Add</button>
        @if (Model.Filters.Any(x => x.Active))
        {
            <button type="button" class="ghost small"
                    title="Untick every substring: all the files show"
                    hx-post="@Url.Page("/Shares/Browse", "ClearFilters", new { id = Model.Folder.Id })" hx-swap="none">Untick all</button>
        }
        @if (Model.Filters.Count == 0)
        {
            <span class="hint-text name-filters-hint">Add substrings to keep only some of the files (nothing ticked: all the files).</span>
        }
    </section>

    <form method="get" class="files-tools" action="@Url.Page("/Shares/Browse", new { id = Model.Folder.Id })">
        <input type="hidden" name="path" value="@listing.Relative" />
        @if (Model.Sort != "name") { <input type="hidden" name="sort" value="@Model.Sort" /> }
        @if (Model.Descending) { <input type="hidden" name="dir" value="desc" /> }
        <input type="search" name="q" value="@Model.Query" placeholder="Filter by name…" title="Case and accents do not matter" aria-label="Filter by name" autocomplete="off" />
        <button type="submit" class="ghost">Filter</button>
        @if (Model.Query.Length > 0)
        {
            <a class="button ghost" href="@Link(listing.Relative, null, null, 1).Replace("q=" + Uri.EscapeDataString(Model.Query), "").TrimEnd('&', '?')">Clear</a>
        }
        <span class="count">
            @listing.Total @(listing.Total == 1 ? "entry" : "entries")@(Model.Filters.Any(x => x.Active) ? " (files filtered by the ticked substrings)" : "")@(listing.Capped ? " (the first " + ShareBrowser.MaxEntries + "; filter to narrow)" : "")
        </span>
    </form>

    @if (listing.Total == 0)
    {
        <p class="empty">@(Model.Query.Length > 0 ? "Nothing matches the filter." : "This folder is empty.")</p>
    }
    else
    {
        <section class="group files-group">
            <table class="files-table">
                <thead>
                    <tr>
                        <th><a href="@SortLink("name")">Name@(Arrow("name"))</a></th>
                        <th class="num"><a href="@SortLink("size")">Size@(Arrow("size"))</a></th>
                        <th><a href="@SortLink("date")">Modified@(Arrow("date"))</a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (parent is not null && listing.Page == 1)
                    {
                        <tr class="folder-row up-row">
                            <td><a class="file-folder" href="@Link(parent)" title="Back to the folder above">.. <span class="up-hint">up one level</span></a></td>
                            <td class="num">—</td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    @foreach (var e in listing.Entries)
                    {
                        <tr class="@(e.IsDirectory ? "folder-row" : null)">
                            <td>
                                @if (e.IsDirectory)
                                {
                                    <a class="file-folder" href="@Link(e.Relative)">@e.Name</a>
                                }
                                else
                                {
                                    <a href="@Url.Page("/Shares/Browse", "Download", new { id = Model.Folder.Id, path = e.Relative })"
                                       title="Download">@e.Name</a>
                                }
                            </td>
                            <td class="num">@(e.IsDirectory ? "—" : HumanSize(e.Size))</td>
                            <td>@e.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="num">
                                @if (!e.IsDirectory)
                                {
                                    <a class="button ghost small-link"
                                       href="@Url.Page("/Shares/Browse", "Download", new { id = Model.Folder.Id, path = e.Relative })">Download</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        @if (listing.Pages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (listing.Page > 1) { <a class="button ghost" href="@Link(listing.Relative, null, null, listing.Page - 1)">← Previous</a> }
                <span>Page @listing.Page of @listing.Pages</span>
                @if (listing.Page < listing.Pages) { <a class="button ghost" href="@Link(listing.Relative, null, null, listing.Page + 1)">Next →</a> }
            </nav>
        }
    }
}
