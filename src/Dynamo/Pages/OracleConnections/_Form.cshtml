@model Dynamo.Pages.OracleConnections.ConnectionFormModel
@{
    var c = Model.Connection;
    string Handler(string name, object? values = null) =>
        Url.Page("/OracleConnections/Index", name, values)!;
}
<form hx-post="@Handler("Save")" hx-target="#connections" hx-swap="outerHTML">
    <h2>@(Model.CopyFrom != 0 ? "Duplicate connection" : c.Id == 0 ? "New connection" : "Edit connection")</h2>
    <input type="hidden" name="id" value="@c.Id" />
    <input type="hidden" name="copyFrom" value="@Model.CopyFrom" />
    @if (Model.CopyOf is not null)
    {
        <p class="hint-text">A copy of “@Model.CopyOf”. Change what should differ, then save.</p>
    }

    <label>Name
        @* On a copy the name is the first thing to change: start with it selected. *@
        <input name="name" value="@c.Name" autocomplete="off" autofocus placeholder="PROD"
               onfocus="@(Model.CopyOf is not null ? "this.select()" : null)" />
    </label>
    <label>Data source
        <input name="dataSource" value="@c.DataSource" autocomplete="off" spellcheck="false"
               placeholder="host:1521/service  ·  TNS alias  ·  (DESCRIPTION=…)" />
    </label>
    <label>Schema
        <input name="username" value="@c.Username" autocomplete="off" spellcheck="false" />
    </label>
    <label>Password
        <input name="password" type="password" autocomplete="new-password"
               placeholder="@(Model.CopyOf is not null ? $"same as “{Model.CopyOf}”" : c.Id == 0 ? "" : "unchanged")" />
    </label>

    @* A DBA connection logs in AS SYSDBA; only these get the DBA features (workspace templates,
       the sessions panel). *@
    <label class="check">
        <input type="checkbox" name="dba" value="on" checked="@c.Dba" />
        DBA connection (log in AS SYSDBA)
    </label>
    <p class="hint-text">
        Usually the schema is SYS. The DBA features (workspace templates, the sessions panel with its Kill
        button) are offered on DBA connections only.
    </p>

    @* The colour of the title bar of the panels that use this connection. *@
    <fieldset class="swatches">
        <legend>Colour</legend>
        <label class="swatch none" title="None">
            <input type="radio" name="color" value="" checked="@(c.Color is null)" />
            <span></span>
        </label>
        @foreach (var color in ConnectionColors.All)
        {
            <label class="swatch" title="@color.Label" style="--hue:var(--conn-@color.Key)">
                <input type="radio" name="color" value="@color.Key" checked="@(c.Color == color.Key)" />
                <span></span>
            </label>
        }
    </fieldset>

    @if (Model.Error is not null)
    {
        <p class="error">@Model.Error</p>
    }

    <footer>
        @if (c.Id != 0)
        {
            <button type="button" class="ghost danger"
                    hx-post="@Handler("Delete", new { id = c.Id })"
                    hx-confirm="Delete the connection “@c.Name”?">Delete</button>
        }
        @if (c.Id != 0)
        {
            @* Copies the saved connection, not unsaved changes in this form. *@
            <button type="button" class="ghost" title="Start a new connection from this one"
                    hx-get="@Handler("Duplicate", new { id = c.Id })"
                    hx-target="#dlg" hx-swap="innerHTML">Duplicate</button>
        }
        <button type="button" class="ghost"
                hx-post="@Handler("TestForm")" hx-include="closest form" hx-swap="none">Test</button>
        <span class="spacer"></span>
        <button type="button" class="ghost" data-close>Cancel</button>
        <button type="submit">Save</button>
    </footer>
</form>
