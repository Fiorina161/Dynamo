@page "/Workplaces/{id:long}"
@model Dynamo.Pages.Workplaces.ViewModel
@{
    var w = Model.Workplace;
    ViewData["Title"] = w.Name;
    var binds = w.SharedBinds();
    string Handler(string name, object? values = null) =>
        Url.Page("/Workplaces/View", name, values ?? new { id = w.Id })!;
}

<header class="page-head">
    <div class="greeting">
        <p><a class="back" href="@Url.Page("/Workplaces/Index")">← Workspaces</a></p>
        <h1>@w.Name</h1>
    </div>
    <div class="actions">
        <button type="button" class="ghost" data-workplace-pause
                title="Stop every automatic refresh until resumed">Pause all</button>
        <button type="button" class="ghost" data-workplace-run-all title="Run every panel now">Run all</button>
        @if (w.Panels.Count > 0)
        {
            <button type="button" class="ghost" data-workplace-collapse-all
                    title="Collapse every panel to its title line, or expand them all">Collapse all</button>
        }
        <button type="button" class="ghost"
                hx-get="@Handler("RenameForm")" hx-target="#dlg">Rename</button>
        <button type="button" class="ghost"
                title="Make a copy of this workspace"
                hx-get="@Handler("DuplicateForm")" hx-target="#dlg">Duplicate</button>
        <button type="button" class="ghost danger"
                hx-post="@Handler("Delete")" hx-swap="none"
                hx-confirm="Delete the workspace “@w.Name” and its queries? The other workspaces are not affected.">Delete</button>
        @if (Model.Connections.Any(c => c.Dba))
        {
            @* The DBA templates need a DBA connection (logging in AS SYSDBA): no button without one. *@
            <button type="button" class="ghost"
                    title="Add ready-made DBA panels to this workspace"
                    hx-get="@Handler("DbaForm")" hx-target="#dlg">Add DBA panels</button>
        }
        <button type="button" class="ghost"
                title="Copy queries from another workspace into this one"
                hx-get="@Handler("ImportForm")" hx-target="#dlg">Import from workspace</button>
        <button type="button"
                title="Write a new query in this workspace"
                hx-get="@Handler("NewQueryForm")" hx-target="#dlg">New query</button>
    </div>
</header>

@* The values shared by every panel: a bind name used by several queries is
   typed once. Enter (or Apply) saves them and runs every panel. *@
<form id="binds" class="workplace-binds" hx-post="@Handler("SaveBinds")" hx-swap="none"
      hidden="@(binds.Count == 0)">
    @foreach (var (name, value) in binds)
    {
        <label>:@name
            <input name="param.@name" value="@value" autocomplete="off" spellcheck="false" />
        </label>
    }
    <button type="submit" title="Save the values and run every panel">Apply</button>
</form>

@if (w.Panels.Count == 0)
{
    <p class="empty">Nothing here yet. Use “New query” to write one, or “Import from workspace” to copy queries from another workspace.</p>
}

@if (w.Panels.Count > 0)
{
    <partial name="_HighlightBox" model="@("[data-workplace]")" />
}

<div class="workplace-grid" data-workplace data-reorder-url="@Handler("ReorderPanels")"
     data-collapse-url="@Handler("CollapsePanel")" data-collapse-all-url="@Handler("CollapseAll")">
    @for (var index = 0; index < w.Panels.Count; index++)
    {
        var p = w.Panels[index];
        var csvButton = new Dynamo.Pages.Shared.ExportButtonModel(
            Handler("CsvPanel", new { id = w.Id, panel = p.Id }), "#binds");
        var tint = Model.Connections.FirstOrDefault(c => c.Name == p.Connection)?.Color;
        <section class="group panel @(p.Collapsed ? "collapsed" : "")@(tint is null ? "" : (p.Collapsed ? " " : "") + "conn-" + tint)" data-panel="@p.Id">
            <header>
                @* Drag by this handle to put the panel elsewhere in the order (site.js, "Reordering panels");
                   the arrow keys on it do the same, and the earlier/later buttons in the details remain. *@
                <button type="button" class="ghost small panel-grip" data-panel-grip
                        title="Drag to put this panel elsewhere in the order"
                        aria-label="Move @p.QueryName: drag, or use the up and down arrow keys">⠿</button>
                @* Collapse to the title line (the panel keeps refreshing, and the line keeps the
                   essentials); clicking the title does the same. Kept on the server (site.js, "Collapsing panels"). *@
                <button type="button" class="ghost small panel-collapse" data-panel-collapse
                        aria-expanded="@(p.Collapsed ? "false" : "true")"
                        title="@(p.Collapsed ? "Expand this panel" : "Collapse this panel to its title")"
                        aria-label="Collapse or expand @p.QueryName">▾</button>
                <h2 class="panel-title" data-panel-title><span class="dot" data-panel-dot aria-hidden="true"></span>@p.QueryName</h2>
                @* What matters while the panel is collapsed: refresh state, row change, filter (site.js). *@
                <span class="panel-info" data-panel-info></span>
                @* Time, rows, duration: the same summary as the Queries page, filled by each run (_PanelResults). *@
                <span class="count" id="panel-count-@p.Id"></span>
                <partial name="_WideButton" model="p.QueryName" />
                @* Copy the rows as TSV, Markdown or a table; vertical view; readable sizes (site.js, "Result tools"). *@
                <button type="button" class="ghost small result-tools" data-result-tools aria-haspopup="menu"
                        title="Copy the rows, vertical view, readable sizes"
                        aria-label="Result tools of @p.QueryName">⋯</button>
                <button type="button" class="ghost small gear" data-panel-toggle
                        aria-expanded="false" title="Details and settings"
                        aria-label="Details and settings of @p.QueryName">⚙</button>
            </header>

            @* Hidden until the gear is used: the page is for the results. Run now
               and the interval act on this panel only. *@
            <form class="panel-form" hidden
                  hx-post="@Handler("RunPanel", new { id = w.Id, panel = p.Id })"
                  hx-include="#binds" hx-target="#panel-out-@p.Id" hx-swap="innerHTML">
                <div class="run-grid">
                    <label>Connection
                        <select name="connection"
                                hx-post="@Handler("PanelSettings", new { id = w.Id, panel = p.Id })"
                                hx-trigger="change" hx-swap="none">
                            @if (p.Connection.Length == 0)
                            {
                                <option value="" selected disabled>(choose)</option>
                            }
                            <partial name="_ConnectionOptions"
                                     model="new ConnectionOptionsModel(p.IsSessions ? Model.Connections.Where(c => c.Dba).ToList() : Model.Connections, p.Connection.Length > 0 ? p.Connection : null)" />
                        </select>
                    </label>
                    <label>Max rows
                        <input name="maxRows" type="number" min="1" max="10000" value="@p.MaxRows"
                               inputmode="numeric"
                               hx-post="@Handler("PanelSettings", new { id = w.Id, panel = p.Id })"
                               hx-trigger="change" hx-swap="none" />
                    </label>
                    @* The panel's height in rows is no longer typed: the bar at the bottom of the panel sets it
                       (site.js, "Resizing a panel"), by changing this field and saving it. 0 = the default
                       number of rows from Settings (@Model.DefaultRows), which new panels start with. *@
                    <input name="viewRows" type="hidden" value="@p.ViewRows"
                           data-view-rows-default="@Model.DefaultRows"
                           data-view-rows-for="#panel-out-@p.Id"
                           hx-post="@Handler("PanelSettings", new { id = w.Id, panel = p.Id })"
                           hx-trigger="change" hx-swap="none" />
                    <label>Refresh
                        <input name="seconds" type="number" min="0" max="3600" value="@p.RefreshSeconds"
                               inputmode="numeric" data-panel-seconds
                               title="Seconds between refreshes; 0 = no automatic refresh"
                               hx-post="@Handler("PanelSettings", new { id = w.Id, panel = p.Id })"
                               hx-trigger="change" hx-swap="none" />
                    </label>
                </div>
                <footer class="run-actions">
                    <button type="submit">Run now</button>
                    <partial name="_ExportButton" model="csvButton" />
                    @if (!p.IsSessions)
                    {
                        <button type="button" class="ghost"
                                title="Rename this panel or change its SQL. Only this workspace's copy changes."
                                hx-get="@Handler("EditQueryForm", new { id = w.Id, panel = p.Id })"
                                hx-target="#dlg" hx-swap="innerHTML" hx-include="this">Edit query</button>
                        <button type="button" class="ghost"
                                title="How Oracle would run this query (EXPLAIN PLAN: the query is not executed)"
                                hx-post="@Handler("Plan", new { id = w.Id, panel = p.Id })"
                                hx-include="#binds, closest form" hx-target="#dlg" hx-swap="innerHTML">Plan</button>
                    }
                    <button type="button" class="ghost" data-move="-1" title="Move this panel earlier in the order"
                            aria-label="Move @p.QueryName earlier"
                            disabled="@(index == 0)"
                            hx-post="@Handler("MovePanel", new { id = w.Id, panel = p.Id, dir = -1 })"
                            hx-swap="none" hx-include="this">↑</button>
                    <button type="button" class="ghost" data-move="1" title="Move this panel later in the order"
                            aria-label="Move @p.QueryName later"
                            disabled="@(index == w.Panels.Count - 1)"
                            hx-post="@Handler("MovePanel", new { id = w.Id, panel = p.Id, dir = 1 })"
                            hx-swap="none" hx-include="this">↓</button>
                    <button type="button" class="ghost danger"
                            hx-post="@Handler("RemovePanel", new { id = w.Id, panel = p.Id })"
                            hx-swap="none" hx-include="this"
                            hx-confirm="Remove “@p.QueryName” from this workspace?">Remove</button>
                    <span class="refresh-status" data-panel-status role="status"></span>
                </footer>
            </form>

            <div class="panel-results" id="panel-out-@p.Id"><p class="empty">Loading…</p></div>

            @* Drag to resize by whole rows (it sets the panel's number of rows); arrow keys: one row; double-click: the default. *@
            <div class="panel-resize" data-panel-resize role="separator" aria-orientation="horizontal" tabindex="0"
                 title="Drag to change the number of visible rows (double-click: the default)"
                 aria-label="Resize @p.QueryName: drag, or use the up and down arrow keys"></div>
        </section>
    }
</div>
