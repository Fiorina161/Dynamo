@page "/Workplaces"
@model Dynamo.Pages.Workplaces.IndexModel
@{
    ViewData["Title"] = "Workspaces";
}

<header class="page-head">
    <div class="greeting">
        <h1>Workspaces</h1>
        <p>A workspace shows several saved queries side by side, each refreshing on its own, to keep an eye on a few things at once.</p>
    </div>
    <div class="actions">
        @if (Model.HasDbaConnection)
        {
            @* The DBA templates need a DBA connection (logging in AS SYSDBA): no button without one. *@
            <button type="button" class="ghost"
                    title="Create a workspace from ready-made DBA panels"
                    hx-get="@Url.Page("/Workplaces/Index", "DbaForm")"
                    hx-target="#dlg">New DBA workspace</button>
        }
        <button type="button"
                hx-get="@Url.Page("/Workplaces/Index", "NewForm")"
                hx-target="#dlg">New workspace</button>
    </div>
</header>

@if (Model.Workplaces.Count == 0)
{
    <p class="empty">No workspaces yet. Use “New workspace”, then add queries to it.</p>
}
else
{
    @* The workspaces are listed on the page itself, not inside a panel. *@
    <ul class="items plain workplace-list">
        @foreach (var w in Model.Workplaces)
        {
            <li class="item">
                <a class="link" href="@Url.Page("/Workplaces/View", new { id = w.Id })">
                    <span class="title">@w.Name</span>
                    <span class="hint">@w.PanelCount @(w.PanelCount == 1 ? "query" : "queries")</span>
                </a>
            </li>
        }
    </ul>
}
