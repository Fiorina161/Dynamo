@inject IEnumerable<IModule> Modules
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var current = Context.Request.Path.Value ?? "/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Dynamo" : "Dynamo")</title>
    <script>
        // Set the theme before first paint to avoid a flash.
        try {
            var saved = localStorage.getItem('theme');
            if (saved) document.documentElement.dataset.theme = saved;
        } catch (e) { }
    </script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}'>
    <div class="shell">
        <nav class="side">
            <a class="brand" href="/">Dynamo</a>
            <ul>
                @foreach (var m in Modules.OrderBy(m => m.Order))
                {
                    <li>
                        <a href="@m.Href"
                           class="@(current.StartsWith(m.Href, StringComparison.OrdinalIgnoreCase) ? "active" : "")">@m.Title</a>
                    </li>
                }
            </ul>
            <button type="button" class="ghost theme-toggle" id="theme-toggle"
                    title="Switch between light, dark and system theme">Theme</button>
        </nav>
        <main>
            @RenderBody()
        </main>
    </div>

    <dialog id="dlg"></dialog>
    <div id="toast" role="status" aria-live="polite"></div>

    <script src="~/lib/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
