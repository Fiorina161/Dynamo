@model Dynamo.Pages.Queries.ResultsModel
@if (Model.Error is not null)
{
    <section class="group full">
        <pre class="error">@Model.Error</pre>
    </section>
}
else if (Model.Result is { } r)
{
    <section class="group full results-panel">
        <header>
            <h2>Results</h2>
            <span class="count">
                <span class="ran-at" title="When this result was fetched">@DateTime.Now.ToString("HH:mm:ss")</span> ·
                @r.Rows.Count @(r.Rows.Count == 1 ? "row" : "rows") · @r.ElapsedMs ms@(r.Truncated ? " · more rows exist, raise Max rows or export" : "")
            </span>
        </header>

        @if (r.Columns.Count == 0)
        {
            <p class="empty">The query returned no columns.</p>
        }
        else
        {
            <div class="results">
                <table>
                    <thead>
                        <tr>
                            @foreach (var c in r.Columns)
                            {
                                <th class="@(c.Numeric ? "num" : "")">@c.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in r.Rows)
                        {
                            <tr>
                                @for (var i = 0; i < row.Length; i++)
                                {
                                    var cell = row[i];
                                    if (cell is null)
                                    {
                                        <td class="null">NULL</td>
                                    }
                                    else
                                    {
                                        <td class="@(r.Columns[i].Numeric ? "num" : "")" title="@(cell.Length > 120 ? cell : null)">@cell</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (r.Rows.Count == 0)
            {
                <p class="empty">No rows.</p>
            }
        }
    </section>
}
