@model IReadOnlyList<Dynamo.Pages.Queries.QueryGroup>
@{
    string Handler(string name, object? values = null) =>
        Url.Page("/Queries/Index", name, values)!;
}

@* Every action inside replaces the list; the Edit button overrides the target. *@
<div id="queries" hx-target="#queries" hx-swap="outerHTML">
    @if (Model.Count == 0)
    {
        <p class="empty">No queries yet. Use “New query” to save the first one.</p>
    }
    else
    {
        @* Flat: the categories are headings on the page itself, not cards. *@
        <div class="cards flat">
            @foreach (var g in Model)
            {
                <section class="group @(g.Collapsed ? "collapsed" : "")">
                    <header>
                        <h2>
                            <button type="button" class="toggle"
                                    title="@(g.Collapsed ? "Expand" : "Collapse")"
                                    aria-expanded="@(g.Collapsed ? "false" : "true")"
                                    hx-post="@Handler("ToggleCategory", new { category = g.Category })">
                                <span class="chev" aria-hidden="true">▾</span>@(g.Category.Length == 0 ? "Uncategorized" : g.Category)
                            </button>
                        </h2>
                        <span class="count">@g.Queries.Count</span>
                    </header>
                    <ul class="items plain">
                        @foreach (var q in g.Queries)
                        {
                            <li class="item">
                                <a class="link" href="@Url.Page("/Queries/Run", new { id = q.Id })">
                                    <span class="title">@q.Name</span>
                                    <span class="hint">@(q.Notes.Length > 0 ? q.Notes : q.Connection.Length > 0 ? q.Connection : "choose a connection when running")</span>
                                </a>
                                <button type="button" class="ghost small edit" title="Edit"
                                        aria-label="Edit @q.Name"
                                        hx-get="@Handler("Form", new { id = q.Id })"
                                        hx-target="#dlg" hx-swap="innerHTML">Edit</button>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>
